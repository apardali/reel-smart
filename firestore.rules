rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Admin = this one email, verified, signed in WITH the Authenticator (TOTP) code.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'alex@polyq.ai'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_second_factor == 'totp';
    }

    // Clip links and admin-made questions: anyone can read, only the admin can change.
    match /clips/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /custom/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Game rooms. The TV that creates a room owns it; each phone owns its own player doc.
    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && code.matches('^[A-Z]{4}$')
        && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /players/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 18;
        allow delete: if signedIn() && (request.auth.uid == uid
          || get(/databases/$(database)/documents/rooms/$(code)).data.hostUid == request.auth.uid);
      }
    }
  }
}
