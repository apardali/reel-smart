rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /clips/{file} {
      // Anyone playing can stream clips.
      allow read: if true;
      // Only the admin, signed in with the Authenticator code, can upload or delete. Videos up to 100 MB.
      allow write: if request.auth != null
        && request.auth.token.email == 'alex@polyq.ai'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_second_factor == 'totp'
        && (request.resource == null
            || (request.resource.size < 100 * 1024 * 1024
                && request.resource.contentType.matches('video/.*')));
    }
  }
}
